# Copia este archivo como .env.local y completa los valores.
# Sin estos valores la tienda funciona con productos de ejemplo y sin pagos.

# URL pública de la tienda (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: solo en el servidor, nunca la compartas ni la subas a GitHub
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > Credenciales (usa las de prueba al inicio)
MERCADOPAGO_ACCESS_TOKEN=
