# Copia este archivo como .env.local y completa los valores.
# Sin estos valores la tienda funciona con productos de ejemplo y sin pagos.

# URL pública de la tienda (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: solo en el servidor, nunca la compartas ni la subas a GitHub
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > Credenciales (usa las de prueba al inicio)
MERCADOPAGO_ACCESS_TOKEN=

# Correos que pueden entrar al panel /admin (separados por coma)
ADMIN_EMAILS=

# Correos automáticos (confirmación de pago, envío, aviso de venta y de cotización).
# Salen desde la casilla contacto@terc.cl del hosting. Solo es obligatoria la contraseña;
# sin ella la tienda funciona igual, pero no envía correos.
SMTP_PASSWORD=
# Opcionales (estos son los valores por defecto):
# SMTP_HOST=s510.v2nets.com
# SMTP_PORT=465
# SMTP_USER=contacto@terc.cl
